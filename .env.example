# Required for MOENV-backed facility, CEMS, and reference-air fetches.
MOENV_API_KEY=

# Required for the CWA weather recorder.
CWA_API_KEY=

# Optional; without it, the evidence stage records that FIRMS was not queried.
FIRMS_MAP_KEY=

# Optional comma-separated browser origins. Defaults to the local Vite hosts.
AIRTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
